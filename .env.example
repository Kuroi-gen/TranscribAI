# ==============================================================================
# TranscribAI 設定ファイル (.env)
# アプリケーション本体とは分離された Azure OpenAI API キー・環境設定ファイルです。
# ==============================================================================

# ── ダミーモード切り替え ─────────────────────────────────────────────────────
# True  : ダミー応答モード（課金なし・APIキー未設定でも録音やGUIのテストが可能）
# False : 本番モード（実際の Azure OpenAI API を呼び出す）
USE_DUMMY_API=True

# ── Azure OpenAI 基本認証情報 ────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_API_KEY_HERE
AZURE_OPENAI_API_VERSION=2024-06-01

# ── デプロイメント名（モデル名）設定 ─────────────────────────────────────────
# 1) AI要約用チャットデプロイメント名 (例: gpt-4o, gpt-4o-mini 等)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# 2) 音声文字起こし用デプロイメント名 (例: whisper, gpt-4o-transcribe, gpt-4o-mini-transcribe, gpt-4o-audio-preview 等)
#    ※未指定の場合は AZURE_OPENAI_DEPLOYMENT_NAME が使用されます
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=whisper

# ── 文字起こしAPIの方式 (TRANSCRIPTION_MODE) ─────────────────────────────────
# ご利用の Azure OpenAI 環境でデプロイされているモデルに合わせて選択してください:
#   audio_api  : Whisper / gpt-4o-transcribe / gpt-4o-mini-transcribe 用 (Audio Transcriptions API)
#   chat_audio : gpt-4o-audio-preview / gpt-4o-mini-audio-preview 用 (Chat Completions Audio Input)
TRANSCRIPTION_MODE=audio_api

# ── 音声認識の言語コードとチャンク分割設定 ───────────────────────────────────
TRANSCRIPTION_LANGUAGE=ja
AUDIO_CHUNK_SECONDS=5.0
SILENCE_DURATION_SECONDS=0.8

# ── プロキシ・SSL設定（社内ネットワーク環境等向け） ──────────────────────────
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
PROXY_PREFERENCE=https
DISABLE_SSL_VERIFY=False
